{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/routes/patient-new.routes.ts",
    "src/routes/phid.routes.ts",
    "src/routes/credit-score.routes.ts",
    "src/scripts/seed-phid-data.ts",
    "src/services/*.ts"
  ]
}
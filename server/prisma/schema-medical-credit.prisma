// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  role        Role     @default(PATIENT)
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  patient     Patient?
  provider    Provider?
  admin       Admin?

  @@map("users")
}

enum Role {
  PATIENT
  PROVIDER
  ADMIN
}

// Patient Information
model Patient {
  id              String   @id @default(cuid())
  userId          String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  phone           String?
  address         String?
  bloodGroup      String?
  emergencyContact String?
  profileComplete  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditScores       CreditScore[]
  medicalActivities   MedicalActivity[]
  evaluations        ProviderEvaluation[]
  appointments       Appointment[]
  bills              TreatmentBill[]
  emiPlans           EMIPlan[]
  charityRequests    CharityRequest[]
  loyaltyPoints       LoyaltyPoint[]
  documents          MedicalDocument[]

  @@map("patients")
}

// Provider Information
model Provider {
  id            String   @id @default(cuid())
  userId        String   @unique
  hospitalName  String
  specialization String?
  licenseNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations  ProviderEvaluation[]
  appointments Appointment[]

  @@map("providers")
}

// Admin Information
model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  level     String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// Credit Score System
model CreditScore {
  id                    String   @id @default(cuid())
  patientId             String
  score                 Int      // 300-850 range
  scoreCategory          ScoreCategory
  paymentHistoryScore    Float    @default(0) // 40% weight
  insuranceScore         Float    @default(0) // 25% weight
  incomeScore            Float    @default(0) // 20% weight
  medicalRiskScore       Float    @default(0) // 15% weight
  bonusPoints           Int      @default(0)
  calculatedAt          DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("credit_scores")
}

enum ScoreCategory {
  EXCELLENT  // 800+
  GOOD       // 650-799
  AVERAGE    // 500-649
  LOW        // <500
}

// Medical Activities
model MedicalActivity {
  id                String   @id @default(cuid())
  patientId         String
  activityType      ActivityType
  activityTitle     String
  description       String?
  pointsEarned      Int      @default(0)
  completedAt       DateTime @default(now())
  metadata          Json?
  createdAt         DateTime @default(now())

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_activities")
}

enum ActivityType {
  CHECKUP
  MEDICINE
  EDUCATION
  APPOINTMENT
  EXERCISE
  DIET
  SLEEP
  BLOOD_PRESSURE
  BLOOD_SUGAR
  WEIGHT
  OTHER
}

// Provider Evaluations
model ProviderEvaluation {
  id            String   @id @default(cuid())
  patientId     String
  providerId    String
  evaluationType EvaluationType
  bonusPoints   Int
  reason        String
  comments      String?
  status        EvaluationStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_evaluations")
}

enum EvaluationType {
  LOYALTY_BONUS
  TRUST_RECOGNITION
  TREATMENT_ADHERENCE
  EMERGENCY_RESPONSE
  REFERRAL_BONUS
  SPECIAL_RECOGNITION
}

enum EvaluationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Appointments
model Appointment {
  id            String   @id @default(cuid())
  patientId     String
  providerId    String?
  appointmentType String
  title         String
  description   String?
  scheduledFor  DateTime
  duration      Int      @default(30) // minutes
  status        AppointmentStatus @default(SCHEDULED)
  cost          Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Billing & EMI
model TreatmentBill {
  id              String   @id @default(cuid())
  patientId       String
  billNumber      String   @unique
  title           String
  description     String?
  totalAmount     Float
  discountAmount  Float    @default(0)
  finalAmount     Float
  creditScore     Int      // Score at time of billing
  discountRate    Float    @default(0) // Percentage based on credit score
  status          BillStatus @default(PENDING)
  dueDate         DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  emiPlans  EMIPlan[]

  @@map("treatment_bills")
}

enum BillStatus {
  PENDING
  APPROVED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model EMIPlan {
  id              String   @id @default(cuid())
  patientId       String
  billId          String
  planNumber      String   @unique
  principalAmount Float
  interestRate    Float
  processingFee   Float    @default(0)
  totalAmount     Float
  emiAmount       Float
  duration        Int      // months
  startDate       DateTime
  endDate         DateTime
  status          EMIStatus @default(ACTIVE)
  nextPaymentDate DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bill    TreatmentBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  payments EMIPayment[]

  @@map("emi_plans")
}

enum EMIStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

model EMIPayment {
  id          String   @id @default(cuid())
  emiPlanId   String
  paymentDate DateTime @default(now())
  amount      Float
  status      PaymentStatus @default(PENDING)
  transactionId String?
  createdAt   DateTime @default(now())

  // Relations
  emiPlan EMIPlan @relation(fields: [emiPlanId], references: [id], onDelete: Cascade)

  @@map("emi_payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// Charity & Sponsorship
model CharityRequest {
  id            String   @id @default(cuid())
  patientId     String
  treatmentId    String?
  requestedAmount Float
  reason         String
  status        CharityStatus @default(PENDING)
  approvedAmount Float?
  approvedBy    String?
  approvedAt    DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("charity_requests")
}

enum CharityStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FUNDED
  COMPLETED
}

// Loyalty Points System
model LoyaltyPoint {
  id          String   @id @default(cuid())
  patientId   String
  points      Int      @default(0)
  reason      String
  source      PointSource
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("loyalty_points")
}

enum PointSource {
  ACTIVITY
  APPOINTMENT
  EVALUATION
  REFERRAL
  BONUS
  LOYALTY
}

// Medical Documents
model MedicalDocument {
  id          String   @id @default(cuid())
  patientId   String
  fileName    String
  filePath    String
  fileType    String
  fileSize    Int
  category    String
  description String?
  uploadedAt  DateTime @default(now())

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_documents")
}

// Health Tasks
model HealthTask {
  id          String   @id @default(cuid())
  patientId   String
  title       String
  description String?
  taskType    TaskType
  points      Int      @default(0)
  targetValue Int?
  currentValue Int      @default(0)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("health_tasks")
}

enum TaskType {
  DAILY_WALKING
  MEDICINE_ADHERENCE
  BLOOD_PRESSURE_CHECK
  BLOOD_SUGAR_CHECK
  WEIGHT_TRACKING
  HEALTH_QUIZ
  EDUCATION_VIDEO
  EXERCISE
  DIET_LOG
  SLEEP_TRACKING
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  SKIPPED
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum NotificationType {
  APPOINTMENT_REMINDER
  PAYMENT_DUE
  SCORE_UPDATE
  ACTIVITY_COMPLETED
  EVALUATION_APPROVED
  BILL_GENERATED
  EMI_REMINDER
  CHARITY_APPROVED
  SYSTEM_ANNOUNCEMENT
}

// System Configuration
model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  category    String
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("system_configs")
}

// Audit Logs
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

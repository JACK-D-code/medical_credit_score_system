      const where: any = { patientId };

      if (filters.status) {
        where.status = filters.status;
      }

      if (filters.taskType) {
        where.taskType = filters.taskType;
      }

      const skip = ((filters.page || 1) - 1) * (filters.limit || 20);

      const [tasks, total] = await Promise.all([
        prisma.healthTask.findMany({
          where,
          orderBy: { createdAt: 'desc' },
          skip,
          take: filters.limit || 20
        }),
        prisma.healthTask.count({ where })
      ]);

      const totalPages = Math.ceil(total / (filters.limit || 20));

      return {
        tasks,
        total,
        page: filters.page || 1,
        totalPages
      };

    } catch (error) {
      console.error('Error fetching health tasks:', error);
      throw error;
    }
  }

  /**
   * Create health task
   */
  async createHealthTask(taskData: any): Promise<any> {
    try {
      const task = await prisma.healthTask.create({
        data: {
          patientId: taskData.patientId,
          title: taskData.title,
          description: taskData.description,
          taskType: taskData.taskType,
          points: taskData.points || this.getTaskPoints(taskData.taskType),
          targetValue: taskData.targetValue,
          currentValue: 0,
          status: 'PENDING'
        }
      });

      // Send notification
      await this.websocketService.sendNotification(taskData.patientId, {
        title: 'New Health Task',
        message: `A new health task "${taskData.title}" has been created.`,
        type: 'SYSTEM_ANNOUNCEMENT'
      });

      return task;

    } catch (error) {
      console.error('Error creating health task:', error);
      throw error;
    }
  }

  /**
   * Complete health task
   */
  async completeHealthTask(taskId: string): Promise<any> {
    try {
      const task = await prisma.healthTask.update({
        where: { id: taskId },
        data: {
          status: 'COMPLETED',
          currentValue: 1
        }
      });

      // Track as activity
      await this.trackActivity({
        patientId: task.patientId,
        activityType: 'TASK_COMPLETION',
        activityTitle: `Completed: ${task.title}`,
        description: `Health task completed successfully`,
        points: task.points
      });

      return task;

    } catch (error) {
      console.error('Error completing health task:', error);
      throw error;
    }
  }

  /**
   * Update health task
   */
  async updateHealthTask(taskId: string, updateData: any): Promise<any> {
    try {
      const updatedTask = await prisma.healthTask.update({
        where: { id: taskId },
        data: updateData
      });

      return updatedTask;

    } catch (error) {
      console.error('Error updating health task:', error);
      throw error;
    }
  }

  /**
   * Get appointments
   */
  async getAppointments(patientId: string, filters: AppointmentFilters): Promise<any> {
    try {
      const where: any = { patientId };

      if (filters.status) {
        where.status = filters.status;
      }

      if (filters.startDate || filters.endDate) {
        where.scheduledFor = {};
        if (filters.startDate) {
          where.scheduledFor.gte = new Date(filters.startDate);
        }
        if (filters.endDate) {
          where.scheduledFor.lte = new Date(filters.endDate);
        }
      }

      const skip = ((filters.page || 1) - 1) * (filters.limit || 20);

      const [appointments, total] = await Promise.all([
        prisma.appointment.findMany({
          where,
          include: {
            provider: {
              select: {
                hospitalName: true
              }
            }
          },
          orderBy: { scheduledFor: 'asc' },
          skip,
          take: filters.limit || 20
        }),
        prisma.appointment.count({ where })
      ]);

      const totalPages = Math.ceil(total / (filters.limit || 20));

      return {
        appointments,
        total,
        page: filters.page || 1,
        totalPages
      };

    } catch (error) {
      console.error('Error fetching appointments:', error);
      throw error;
    }
  }

  /**
   * Create appointment
   */
  async createAppointment(appointmentData: any): Promise<any> {
    try {
      const appointment = await prisma.appointment.create({
        data: {
          patientId: appointmentData.patientId,
          providerId: appointmentData.providerId,
          appointmentType: appointmentData.appointmentType,
          title: appointmentData.title,
          description: appointmentData.description,
          scheduledFor: new Date(appointmentData.scheduledFor),
          duration: appointmentData.duration || 30,
          cost: appointmentData.cost,
          status: 'SCHEDULED'
        }
      });

      // Send notification to patient
      await this.websocketService.sendNotification(appointmentData.patientId, {
        title: 'Appointment Scheduled',
        message: `Your appointment "${appointmentData.title}" has been scheduled for ${appointmentData.scheduledFor}.`,
        type: 'APPOINTMENT_REMINDER'
      });

      // Send notification to provider if assigned
      if (appointmentData.providerId) {
        await this.websocketService.sendNotification(appointmentData.providerId, {
          title: 'New Appointment',
          message: `New appointment scheduled: ${appointmentData.title}`,
          type: 'APPOINTMENT_REMINDER'
        });
      }

      return appointment;

    } catch (error) {
      console.error('Error creating appointment:', error);
      throw error;
    }
  }

  /**
   * Update appointment
   */
  async updateAppointment(appointmentId: string, updateData: any): Promise<any> {
    try {
      const updatedAppointment = await prisma.appointment.update({
        where: { id: appointmentId },
        data: updateData
      });

      // Send notification
      await this.websocketService.sendNotification(updatedAppointment.patientId, {
        title: 'Appointment Updated',
        message: `Your appointment has been updated.`,
        type: 'APPOINTMENT_REMINDER'
      });

      return updatedAppointment;

    } catch (error) {
      console.error('Error updating appointment:', error);
      throw error;
    }
  }

  /**
   * Cancel appointment
   */
  async cancelAppointment(appointmentId: string, reason?: string): Promise<void> {
    try {
      const appointment = await prisma.appointment.update({
        where: { id: appointmentId },
        data: {
          status: 'CANCELLED'
        }
      });

      // Send notification
      await this.websocketService.sendNotification(appointment.patientId, {
        title: 'Appointment Cancelled',
        message: reason || 'Your appointment has been cancelled.',
        type: 'APPOINTMENT_REMINDER'
      });

    } catch (error) {
      console.error('Error cancelling appointment:', error);
      throw error;
    }
  }


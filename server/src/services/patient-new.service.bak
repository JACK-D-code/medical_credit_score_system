import { PrismaClient } from '@prisma/client';
import { WebSocketService } from './websocket.service';

const prisma = new PrismaClient();

export interface PatientProfile {
  id: string;
  firstName: string;
  lastName: string;
  dateOfBirth: Date;
  phone?: string;
  address?: string;
  bloodGroup?: string;
  emergencyContact?: string;
  email: string;
  creditScore?: number;
  loyaltyLevel?: string;
  trustScore?: number;
  adherenceScore?: number;
  totalPoints?: number;
  profileComplete?: boolean;
}

export interface ActivityFilters {
  activityType?: string;
  startDate?: string;
  endDate?: string;
  page?: number;
  limit?: number;
}

export interface AppointmentFilters {
  status?: string;
  startDate?: string;
  endDate?: string;
  page?: number;
  limit?: number;
}

export interface BillFilters {
  status?: string;
  startDate?: string;
  endDate?: string;
  page?: number;
  limit?: number;
}

export class PatientService {
  private websocketService: WebSocketService;

  constructor() {
    this.websocketService = new WebSocketService();
  }

  /**
   * Get patient profile
   */
  async getPatientProfile(patientId: string): Promise<PatientProfile> {
    try {
      const patient = await prisma.patient.findUnique({
        where: { id: patientId },
        include: {
          user: {
            select: {
              email: true
            }
          },
          creditScores: {
            orderBy: { calculatedAt: 'desc' },
            take: 1
          },
          medicalActivities: {
            orderBy: { completedAt: 'desc' },
            take: 10
          }
        }
      });

      if (!patient) {
        throw new Error('Patient not found');
      }

      // Calculate derived values
      const currentCreditScore = patient.creditScores[0]?.score || 0;
      const loyaltyLevel = this.getLoyaltyLevel(currentCreditScore);
      const totalPoints = patient.medicalActivities.reduce((sum, activity) => sum + activity.pointsEarned, 0);
      const adherenceScore = this.calculateAdherenceScore(patient.medicalActivities);

      return {
        id: patient.id,
        firstName: patient.firstName,
        lastName: patient.lastName,
        dateOfBirth: patient.dateOfBirth,
        phone: patient.phone,
        address: patient.address,
        bloodGroup: patient.bloodGroup,
        emergencyContact: patient.emergencyContact,
        email: patient.user.email,
        creditScore: currentCreditScore,
        loyaltyLevel,
        trustScore: 85, // Mock calculation
        adherenceScore,
        totalPoints,
        profileComplete: patient.profileComplete
      };

    } catch (error) {
      console.error('Error fetching patient profile:', error);
      throw error;
    }
  }

  /**
   * Update patient profile
   */
  async updatePatientProfile(patientId: string, profileData: Partial<PatientProfile>): Promise<PatientProfile> {
    try {
      const updatedPatient = await prisma.patient.update({
        where: { id: patientId },
        data: {
          firstName: profileData.firstName,
          lastName: profileData.lastName,
          phone: profileData.phone,
          address: profileData.address,
          bloodGroup: profileData.bloodGroup,
          emergencyContact: profileData.emergencyContact,
          profileComplete: true
        }
      });

      // Send notification
      await this.websocketService.sendNotification(patientId, {
        title: 'Profile Updated',
        message: 'Your profile has been successfully updated.',
        type: 'SYSTEM_ANNOUNCEMENT'
      });

      return this.getPatientProfile(patientId);

    } catch (error) {
      console.error('Error updating patient profile:', error);
      throw error;
    }
  }

  /**
   * Upload medical document
   */
  async uploadDocument(documentData: any): Promise<any> {
    try {
      const document = await prisma.medicalDocument.create({
        data: {
          patientId: documentData.patientId,
          fileName: documentData.fileName,
          filePath: documentData.filePath,
          fileType: documentData.fileType,
          fileSize: documentData.fileSize,
          category: documentData.category,
          description: documentData.description
        }
      });

      // Send notification
      await this.websocketService.sendNotification(documentData.patientId, {
        title: 'Document Uploaded',
        message: `Your ${documentData.category} document has been uploaded successfully.`,
        type: 'SYSTEM_ANNOUNCEMENT'
      });

      return document;

    } catch (error) {
      console.error('Error uploading document:', error);
      throw error;
    }
  }

  /**
   * Get patient documents
   */
  async getPatientDocuments(patientId: string): Promise<any[]> {
    try {
      const documents = await prisma.medicalDocument.findMany({
        where: { patientId },
        orderBy: { uploadedAt: 'desc' }
      });

      return documents;

    } catch (error) {
      console.error('Error fetching patient documents:', error);
      throw error;
    }
  }

  /**
   * Track activity
   */
  async trackActivity(activityData: any): Promise<any> {
    try {
      const activity = await prisma.medicalActivity.create({
        data: {
          patientId: activityData.patientId,
          activityType: activityData.activityType,
          activityTitle: activityData.activityTitle,
          description: activityData.description,
          pointsEarned: this.getActivityPoints(activityData.activityType),
          metadata: activityData.metadata
        }
      });

      // Update credit score based on activity
      await this.updateScoreFromActivity(activity);

      // Send real-time update
      await this.websocketService.broadcastActivityUpdate({
        patientId: activityData.patientId,
        activityId: activity.id,
        newScore: 0, // Would calculate actual score
        pointsEarned: activity.pointsEarned
      });

      return activity;

    } catch (error) {
      console.error('Error tracking activity:', error);
      throw error;
    }
  }

  /**
   * Get patient activities
   */
  async getPatientActivities(patientId: string, filters: ActivityFilters): Promise<any> {
    try {
      const where: any = { patientId };

      if (filters.activityType) {
        where.activityType = filters.activityType;
      }

      if (filters.startDate || filters.endDate) {
        where.completedAt = {};
        if (filters.startDate) {
          where.completedAt.gte = new Date(filters.startDate);
        }
        if (filters.endDate) {
          where.completedAt.lte = new Date(filters.endDate);
        }
      }

      const skip = ((filters.page || 1) - 1) * (filters.limit || 20);

      const [activities, total] = await Promise.all([
        prisma.medicalActivity.findMany({
          where,
          orderBy: { completedAt: 'desc' },
          skip,
          take: filters.limit || 20
        }),
        prisma.medicalActivity.count({ where })
      ]);

      const totalPages = Math.ceil(total / (filters.limit || 20));

      return {
        activities,
        total,
        page: filters.page || 1,
        totalPages
      };

    } catch (error) {
      console.error('Error fetching patient activities:', error);
      throw error;
    }
  }

  /**
   * Delete activity
   */
  async deleteActivity(activityId: string): Promise<void> {
    try {
      await prisma.medicalActivity.delete({
        where: { id: activityId }
      });

    } catch (error) {
      console.error('Error deleting activity:', error);
      throw error;
    }
  }

  /**
   * Get health tasks
   */
  async getHealthTasks(patientId: string, filters: any): Promise<any> {

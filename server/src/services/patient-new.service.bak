  /**
   * Calculate EMI options
   */
  async calculateEMIOptions(amount: number): Promise<any> {
    try {
      // Mock EMI calculation
      const options = [
        { duration: 3, emiAmount: amount / 3, interestRate: 0 },
        { duration: 6, emiAmount: amount / 6, interestRate: 5 },
        { duration: 12, emiAmount: amount / 12, interestRate: 8 },
        { duration: 24, emiAmount: amount / 24, interestRate: 12 }
      ];

      return options;

    } catch (error) {
      console.error('Error calculating EMI options:', error);
      throw error;
    }
  }

  /**
   * Pay EMI
   */
  async payEMI(emiPlanId: string, paymentData: any): Promise<any> {
    try {
      const payment = await prisma.eMIPayment.create({
        data: {
          emiPlanId,
          paymentDate: new Date(),
          amount: paymentData.amount,
          status: 'COMPLETED',
          transactionId: paymentData.transactionId
        }
      });

      // Send notification
      await this.websocketService.sendNotification('', { // Would get patientId from emiPlan
        title: 'EMI Payment Successful',
        message: `Your EMI payment of ₹${paymentData.amount} has been processed.`,
        type: 'PAYMENT_UPDATE'
      });

      return payment;

    } catch (error) {
      console.error('Error paying EMI:', error);
      throw error;
    }
  }


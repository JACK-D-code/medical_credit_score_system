  /**
   * Get dashboard stats
   */
  async getDashboardStats(patientId: string): Promise<any> {
    try {
      const today = new Date();
      const startOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);

      // Get current credit score
      const currentScore = await prisma.creditScore.findFirst({
        where: { patientId },
        orderBy: { calculatedAt: 'desc' }
      });

      // Get activities this month
      const monthlyActivities = await prisma.medicalActivity.count({
        where: {
          patientId,
          completedAt: {
            gte: startOfMonth
          }
        }
      });

      // Get upcoming appointments
      const upcomingAppointments = await prisma.appointment.count({
        where: {
          patientId,
          scheduledFor: {
            gte: today
          },
          status: 'SCHEDULED'
        }
      });

      // Get pending bills
      const pendingBills = await prisma.treatmentBill.count({
        where: {
          patientId,
          status: 'PENDING'
        }
      });

      // Get active EMI plans
      const activeEMIPlans = await prisma.eMIPlan.count({
        where: {
          patientId,
          status: 'ACTIVE'
        }
      });

      return {
        creditScore: currentScore?.score || 0,
        loyaltyLevel: this.getLoyaltyLevel(currentScore?.score || 0),
        monthlyActivities,
        upcomingAppointments,
        pendingBills,
        activeEMIPlans
      };

    } catch (error) {
      console.error('Error fetching dashboard stats:', error);
      throw error;
    }
  }

  /**
   * Generate medical report
   */
  async generateMedicalReport(patientId: string, filters: any): Promise<Buffer> {
    try {
      // In a real implementation, this would generate a PDF report
      const reportData = {
        title: 'Medical Report',
        generatedAt: new Date(),
        patientId,
        filters,
        data: {} // Would fetch actual data
      };

      // Mock PDF buffer
      const pdfContent = JSON.stringify(reportData, null, 2);
      return Buffer.from(pdfContent);

    } catch (error) {
      console.error('Error generating medical report:', error);
      throw error;
    }
  }

  // Helper methods
  private getLoyaltyLevel(score: number): string {
    if (score >= 800) return 'Platinum';
    if (score >= 750) return 'Gold';
    if (score >= 650) return 'Silver';
    return 'Bronze';
  }

  private getActivityPoints(activityType: string): number {
    const pointsMap: { [key: string]: number } = {
      'CHECKUP': 10,
      'MEDICINE': 5,
      'EXERCISE': 8,
      'DIET': 5,
      'SLEEP': 3,
      'BLOOD_PRESSURE': 5,
      'BLOOD_SUGAR': 5,
      'WEIGHT': 3,
      'OTHER': 2
    };
    return pointsMap[activityType] || 2;
  }

  private getTaskPoints(taskType: string): number {
    const pointsMap: { [key: string]: number } = {
      'DAILY_WALKING': 8,
      'MEDICINE_ADHERENCE': 10,
      'BLOOD_PRESSURE_CHECK': 5,
      'BLOOD_SUGAR_CHECK': 5,
      'WEIGHT_TRACKING': 3,
      'HEALTH_QUIZ': 15,
      'EDUCATION_VIDEO': 12,
      'EXERCISE': 8,
      'DIET_LOG': 5,
      'SLEEP_TRACKING': 3
    };
    return pointsMap[taskType] || 5;
  }

  private calculateAdherenceScore(activities: any[]): number {
    // Mock calculation - in real implementation, this would be more sophisticated
    const totalActivities = activities.length;
    const completedActivities = activities.filter(a => a.completedAt).length;
    return totalActivities > 0 ? Math.round((completedActivities / totalActivities) * 100) : 0;
  }

